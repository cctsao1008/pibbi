# Unverified on hardware; build-only. Based on original Watcher target and flash size.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# No network, BLE, audio, LVGL, models or PSRAM needed for B1a.
# ESP-IDF default serial console remains enabled for boot markers.
